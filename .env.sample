# =============================================================================
# Amelia Lawsin — environment variables
# =============================================================================
#
# Setup:
#   1. Copy this file:  cp .env.sample .env
#   2. Fill in every value under "Required" before running the app.
#   3. Restart `npm run dev` after any change.
#
# Notes:
#   - Next.js reads `.env` and `.env.local`; values in `.env.local` override
#     `.env` for local development.
#   - NEXT_PUBLIC_* vars are embedded at build time — set them in Vercel
#     **per environment** (Production vs Preview) before deploying, then
#     redeploy when they change. See docs/PROD_PLATFORMS.md env map.
#     Honest limits of that split: docs/PROD_PLAN_CHALLENGE.md.
#   - This file is for **local / amelia-lawsin-dev** only. Do not put
#     amelia-lawsin-prod DATABASE_URL here. Never put prod keys on Vercel Preview.
#   - Never commit `.env` or share API keys.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Postgres connection string used by Prisma (app queries, server actions, seed).
#
# Supabase (recommended):
#   - App runtime: use the **transaction** pooler (port 6543) with pgbouncer and SSL:
#       postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#   - Migrations: Prisma needs a direct or **session** pooler connection (port 5432).
#     Temporarily swap DATABASE_URL when running `npx prisma migrate dev` / `deploy`,
#     or use a second direct URL in your local workflow. Always include sslmode=require.
#
# Find these in Supabase → Project Settings → Database → Connection string.
DATABASE_URL=


# -----------------------------------------------------------------------------
# Supabase Auth (required)
# -----------------------------------------------------------------------------
# Used for login (email/password + Google OAuth), session refresh in middleware,
# and admin route protection.
#
# Local + Vercel Preview: amelia-lawsin-dev (Preview sharing this DB is a
# documented compromise — see docs/PROD_PLAN_CHALLENGE.md)
# Vercel Production: amelia-lawsin-prod (different project — LAUNCH-002)
#
# Find these in Supabase → Project Settings → API (that project's URL + anon key).
# Google OAuth: enable the provider on **each** project; add that project's
#   https://<ref>.supabase.co/auth/v1/callback
# in Google Cloud → Authorized redirect URIs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Cloudinary (required for admin image uploads)
# -----------------------------------------------------------------------------
# Property photos are uploaded, transformed, and deleted via the Cloudinary API.
# Without these, the public site still works but admin media steps will fail.
#
# Find in Cloudinary → Settings → API Keys.
# Free plan: one product environment — same keys on Preview and Production is OK
# for launch. Folders (dev/, prod/) are naming, not isolation: a Preview/admin
# delete can remove photos the live site still uses. Paid: second product env.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# Email — Resend (required for inquiry & booking notifications)
# -----------------------------------------------------------------------------
# Contact form and schedule-viewing submissions are saved to the database even
# without email, but Amelia and visitors will not receive notification emails.
#
# One Resend account (do not create a second company).
# Optional: a second API key used only in Vercel Production.
#
# 1. Create an account at https://resend.com and add an API key.
# 2. RESEND_FROM_EMAIL must be a sender Resend allows:
#    - Trial: onboarding@resend.dev (can only send to your Resend account email).
#    - Production: verify your domain (e.g. noreply@amelialawsin.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# -----------------------------------------------------------------------------
# Site URL (strongly recommended for production)
# -----------------------------------------------------------------------------
# Canonical public origin — no trailing slash.
# Used for: SEO metadata (metadataBase), sitemap.xml, robots.txt, RSS feed
# (/feed.xml), and property links inside inquiry/booking emails.
#
# Local:  http://localhost:3000
# Vercel Preview: that deployment's URL (or omit)
# Vercel Production: https://amelialawsin.com  (or https://<project>.vercel.app)
#
# Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Google Analytics 4 (optional)
# -----------------------------------------------------------------------------
# Loaded only after the visitor accepts analytics cookies (cookie consent banner).
# Set this **only** in Vercel Production. Leave unset in this file and on Preview
# so localhost / develop traffic does not pollute live reports.
#
# Create a GA4 property at https://analytics.google.com → Admin → Data streams.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# -----------------------------------------------------------------------------
# Playwright E2E (optional; use development/test data only)
# -----------------------------------------------------------------------------
# PLAYWRIGHT_BASE_URL=https://preview.example.com
# Required before any E2E test may write to a database.
# E2E_ALLOW_WRITES=1
# Dedicated development/test database used by local fixture-writing tests.
# Never set this to the production DATABASE_URL.
# E2E_DATABASE_URL=postgresql://...
# Required when PLAYWRIGHT_BASE_URL targets a deployed environment.
# E2E_PUBLISHED_PROPERTY_SLUG=playwright-published-listing
# E2E_PUBLISHED_PROPERTY_TITLE=Playwright Published Listing
# E2E_DRAFT_PROPERTY_SLUG=playwright-draft-listing
# E2E_DRAFT_PROPERTY_TITLE=Playwright Draft Listing
# E2E_ADMIN_EMAIL=admin-test@example.com
# E2E_ADMIN_PASSWORD=
